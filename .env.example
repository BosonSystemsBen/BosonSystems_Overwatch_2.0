DATABASE_URL=postgres://overwatch:overwatch@localhost:5432/overwatch
LISTEN_ADDR=0.0.0.0:8080

# Requis : protège toute l'API/UI (sauf /health) par Basic Auth.
# Choisis un vrai mot de passe, ne commite jamais de vraie valeur ici.
APP_USERNAME=admin
APP_PASSWORD=change-me

# Optionnel en dev : sans ce token, /pennylane/sync répond une erreur claire
# plutôt que de planter. Ne jamais commiter une vraie valeur ici.
PENNYLANE_BASE_URL=https://app.pennylane.com
PENNYLANE_API_TOKEN=

# Optionnel en dev : sans ces 3 valeurs, /shipments/:id/send-to-sendcloud répond
# une erreur claire plutôt que de planter. Ne jamais commiter de vraies valeurs.
# SENDCLOUD_INTEGRATION_ID vient d'une "Integration" créée dans le panel Sendcloud
# (Settings > Integrations), nécessaire pour l'API Orders.
SENDCLOUD_BASE_URL=https://panel.sendcloud.sc/api/v3
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_PRIVATE_KEY=
SENDCLOUD_INTEGRATION_ID=
